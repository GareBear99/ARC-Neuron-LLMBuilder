# ARC-Neuron Direct Runtime — example environment file
# Copy to .env.direct-runtime and fill in values before running the direct runtime.

# Cloudflare Workers AI (used by the live AI operative)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# GitHub operator read token (for ingest-operator-reviews workflow)
OPERATOR_READ_TOKEN=your_pat_here

# Optional: override the default model
ARC_MODEL_OVERRIDE=
